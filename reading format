  { id:'strategies', title:'Reading Strategies', icon:'🧠', type:'static' },
  { id:'practice', title:'Guided Practice', icon:'✍️', type:'practice' },
  { id:'playbook', title:'Test-Day Playbook', icon:'🎮', type:'static' },
  { id:'final', title:'Final Mock Exam', icon:'🏆', type:'quiz' }
];

/* =========================================================
   NAVIGATION
========================================================= */
function goToLesson(i){
  if(i < 0 || i >= LESSONS.length) return;
  state.currentLesson = i;
  saveState();
  render();
  window.scrollTo({top:0, behavior:'smooth'});
}
function completeAndNext(lessonId, nextIndex){
  state.completed[lessonId] = true;
  saveState();
  goToLesson(nextIndex);
}

