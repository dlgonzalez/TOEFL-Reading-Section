function renderPracticeQuestions(){
  const wrap = document.getElementById('practiceQuestions');
  if(!wrap) return;
  wrap.innerHTML = PRACTICE_QUESTIONS.map((pq,i)=>{
    const saved = (state.practiceAnswers && state.practiceAnswers[i]) || {};
    return `
<div class="glass rounded-xl p-5">
  <div class="flex items-center gap-2 mb-2">
    <div class="pill bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">${pq.taskLabel}</div>
    <span class="text-xs text-[var(--muted)]">Practice ${i+1}/${PRACTICE_QUESTIONS.length}</span>
  </div>
  <div class="font-semibold mb-3 text-sm">${pq.q}</div>
  ${pq.passage ? `<div class="mb-3 text-sm">${pq.passage}</div>` : ''}
  ${pq.choices ? `
    <div class="space-y-2" id="pqChoices-${i}">
      ${pq.choices.map((c,ci)=>{
        let cls = 'choice border border-[var(--line)] rounded-lg p-3 text-sm';
        if(saved.submitted){
          if(ci===pq.correct) cls += ' correct';
          else if(ci===saved.answers) cls += ' wrong';
        } else if(saved.answers===ci) cls += ' selected';
        return `<div class="cls}" data-practice-pick="${i}-${ci}">${String.fromCharCode(65+ci)}. ${c}</div>`;
      }).join('')}
    </div>
  ` : `
    <input type="text" data-complete-input="${i}" placeholder="Type your answers separated by commas..." class="w-full bg-[var(--bg)] border border-[var(--line)] rounded px-3 py-2 text-sm focus:border-[var(--accent)] focus:outline-none" value="${saved.answers||''}"/>
  `}
  ${!pq.choices && saved.answers!==undefined && !saved.submitted ? `<button data-practice-submit="${i}" class="btn mt-3 bg-[var(--accent)] text-[var(--bg)] px-4 py-1.5 rounded text-sm font-semibold">Check Answer</button>` : ''}
  ${pq.choices && saved.answers!==undefined && !saved.submitted ? `<button data-practice-submit="${i}" class="btn mt-3 bg-[var(--accent)] text-[var(--bg)] px-4 py-1.5 rounded text-sm font-semibold">Check Answer</button>` : ''}
  ${saved.submitted ? `
    <div class="mt-4 bg-[var(--panel-2)] border-l-4 ${saved.isCorrect?'border-[var(--ok)]':'border-[var(--err)]'} rounded-r-lg p-4 text-sm fade-in">
      <div class="font-bold mb-1 ${saved.isCorrect?'text-[var(--ok)]':'text-[var(--err)]'}">
        ${saved.isCorrect?'✅ Correct!':'❌ Not quite.'}
      </div>
      <div class="text-[var(--muted)]">${pq.explanation}</div>
    </div>
  `:''}
</div>
`;
  }).join('');
}

function pickPractice(qi,ci){
  const pq = PRACTICE_QUESTIONS[qi];
  const saved = (state.practiceAnswers && state.practiceAnswers[qi]) || {};
  if(saved.submitted) return;
  state.practiceAnswers[qi] = {...saved, answers: ci};
  saveState();
  renderPracticeQuestions();
}

function submitPractice(qi){
  const pq = PRACTICE_QUESTIONS[qi];
  const saved = state.practiceAnswers[qi] || {};
  let isCorrect = false;
  let answers = saved.answers;
  if(pq.choices){
    isCorrect = saved.answers === pq.correct;
  } else {
    const input = document.querySelector(`[data-complete-input="${qi}"]`);
    if(!input || !input.value.trim()) return;
    answers = input.value.trim();
    const correctWords = pq.correct.split(', ').map(w=>w.toLowerCase().trim());
    isCorrect = correctWords.every(w => answers.toLowerCase().includes(w));
  }
  state.practiceAnswers[qi] = {...saved, answers, submitted:true, isCorrect};
  saveState();
  renderPracticeQuestions();
}

