        ok = correctWords.every(w => user.toLowerCase().includes(w));
      }
    }
    if(ok){ correct++; module2Correct++; }
    breakdown[globalIndex] = { ok, type:q.type, module:2 };
  });

  const total = ALL_QUIZ.length;
  const pct = correct/total;
  let band;
  if(pct>=0.95) band = 6.0;
  else if(pct>=0.85) band = 5.5;
  else if(pct>=0.75) band = 5.0;
  else if(pct>=0.60) band = 4.5;
  else if(pct>=0.45) band = 4.0;
  else if(pct>=0.30) band = 3.5;
  else if(pct>=0.20) band = 3.0;
  else if(pct>=0.10) band = 2.5;
  else band = 2.0;

  const bandColor = band>=5?'text-[var(--ok)]':band>=4?'text-[var(--accent-2)]':band>=3?'text-[var(--warn)]':'text-[var(--err)]';

  el.innerHTML = `
<div class="fade-in space-y-5 mt-5">
  <div class="glass rounded-2xl p-6 bg-gradient-to-br from-[var(--accent)]/10 to-[var(--accent-2)]/10 border border-[var(--accent)]/30">
    <div class="text-xs uppercase tracking-wider text-[var(--accent)] mb-2">Your Result</div>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="text-5xl font-bold ${bandColor} mono">${band.toFixed(1)}</div>
        <div class="text-sm text-[var(--muted)] mt-1">Estimated Reading Band (1–6)</div>
      </div>
      <div class="text-right">
        <div class="text-2xl font-bold mono">${correct}/${total}</div>
        <div class="text-sm text-[var(--muted)]">Correct · ${Math.round(pct*100)}%</div>
      </div>
    </div>
    <div class="mt-4 grid sm:grid-cols-2 gap-3">
      <div class="strategy-card">
        <div class="text-xs text-[var(--muted)] mb-1">Module 1</div>
        <div class="font-bold text-lg">${module1Correct}/${QUIZ_MODULE_1.length}</div>
      </div>
      <div class="strategy-card" style="border-left-color:var(--accent-2)">
        <div class="text-xs text-[var(--muted)] mb-1">Module 2</div>
        <div class="font-bold text-lg">${module2Correct}/${QUIZ_MODULE_2.length}</div>
      </div>
    </div>
    <div class="mt-4 text-sm text-[var(--muted)]">${bandFeedback(band)}</div>
  </div>

  <div class="glass rounded-xl p-5">
    <div class="text-xs uppercase tracking-wider text-[var(--accent)] mb-3">Detailed Review</div>
    <div class="space-y-3">
      ${ALL_QUIZ.map((q,i)=>{
        const b = breakdown[i];
        return `
<details class="bg-[var(--panel-2)] rounded-lg overflow-hidden">
  <summary class="p-3 flex items-center justify-between cursor-pointer hover:bg-[var(--bg)]">
    <div class="flex items-center gap-2">
      <span class="${b.ok?'text-[var(--ok)]':'text-[var(--err)]'} font-bold">${b.ok?'✅':'❌'}</span>
      <span class="text-sm font-semibold">Q${i+1} · ${q.type} · Module ${b.module}</span>
    </div>
    <span class="text-xs text-[var(--muted)]">Click to expand</span>
  </summary>
  <div class="p-4 pt-0 text-sm space-y-2 border-t border-[var(--line)] mt-0">
    <div class="pt-3 font-semibold">${q.q}</div>
    ${q.choices ? q.choices.map((c,ci)=>{
      let cls = 'border rounded-lg p-2 text-sm';
      let mark = '';
      const isCorrect = ci===q.correct;
      const isUser = state.quiz.answers[i]===ci;
      if(isCorrect){ cls += ' border-[var(--ok)] bg-[var(--ok)]/10'; mark = '✅ Correct answer'; }
      else if(isUser){ cls += ' border-[var(--err)] bg-[var(--err)]/10'; mark = '❌ Your answer'; }
      else { cls += ' border-[var(--line)] opacity-60'; }
      return `<div class="${cls}">${String.fromCharCode(65+ci)}. ${c}${mark?' · <b>'+mark+'</b>':''}</div>`;
    }).join('') : `<div class="text-xs text-[var(--muted)]">Your answer: ${state.quiz.answers[i] || '(none)'}</div>`}
    <div class="bg-[var(--bg)] border-l-2 border-[var(--accent)] rounded-r-lg p-3 text-[var(--muted)]">
      <b class="text-[var(--accent)]">Explanation:</b> ${q.explanation}
    </div>
  </div>
</details>
`;
      }).join('')}
    </div>
  </div>
</div>
`;
}

function bandFeedback(band){
  if(band>=5.5) return "🌟 <b>Outstanding.</b> You're operating at an advanced/proficient level. Focus on polishing speed and the hardest inference questions.";
  if(band>=4.5) return "👍 <b>Strong.</b> You have solid upper-intermediate skills. Target your weakest question types and practice under timed conditions.";
  if(band>=3.5) return "📈 <b>Good foundation.</b> You understand the basics but need to strengthen vocabulary-in-context and inference skills. Revisit Lesson 3 strategies.";
  if(band>=3.0) return "📚 <b>Developing.</b> Focus on the fundamentals: skimming strategies (Lesson 3) and question type recognition (Lesson 2). Retake the quiz after review.";
  return "🌱 <b>Starting out.</b> No worries — that's what this course is for! Go through Lessons 1–4 carefully, do the Guided Practice again, then retake the quiz.";
}

/* =========================================================
   SIDEBAR & STATS
========================================================= */
function renderSidebar(){
  const nav = document.getElementById('lessonNav');
  if(!nav) return;
  nav.innerHTML = LESSONS.map((l,i)=>{
    const done = state.completed[l.id];
    const active = state.currentLesson===i;
    return `
<button data-nav="${i}" class="lesson-card text-left px-3 py-2.5 rounded-lg border border-transparent flex items-center gap-3 ${active?'active':''} ${done?'done':''}">
  <span class="text-lg">${l.icon}</span>
  <div class="flex-1 min-w-0">
    <div class="text-xs text-[var(--muted)]">Lesson ${i+1}</div>
    <div class="text-sm font-semibold truncate">${l.title}</div>
  </div>
  ${done?'<span class="text-[var(--ok)] text-xs">✓</span>':''}
</button>
`;
  }).join('');
}

function updateStats(){
  const staticDone = ['format','tasks','questions','strategies','playbook'].filter(k=>state.completed[k]).length;
  const practiceDone = state.practiceAnswers ? Object.values(state.practiceAnswers).filter(p=>p.submitted).length : 0;
  document.getElementById('statLessons').textContent = `${staticDone}/5`;
  document.getElementById('statPractices').textContent = `${Math.min(practiceDone,PRACTICE_QUESTIONS.length)}/${PRACTICE_QUESTIONS.length}`;
  document.getElementById('statFinal').textContent = state.quiz?.finished ? '✓' : '—';
  const total = 5 + PRACTICE_QUESTIONS.length + 1;
  const done = staticDone + Math.min(practiceDone,PRACTICE_QUESTIONS.length) + (state.quiz?.finished?1:0);
  const pct = Math.round(done/total*100);
  const gp = document.getElementById('globalProgress');
  const gpt = document.getElementById('globalProgressText');
  if(gp) gp.style.width = pct+'%';
  if(gpt) gpt.textContent = pct+'%';
}

/* =========================================================
   MAIN RENDER
========================================================= */
function render(){
  renderSidebar();
  const lesson = LESSONS[state.currentLesson];
  const main = document.getElementById('mainContent');
  if(!main) return;

  if(lesson.type==='static'){
    if(lesson.id==='welcome') main.innerHTML = WELCOME_HTML;
    else if(lesson.id==='format') main.innerHTML = FORMAT_HTML;
    else if(lesson.id==='tasks') main.innerHTML = renderTasksLesson();
    else if(lesson.id==='questions') main.innerHTML = renderQuestionsLesson();
    else if(lesson.id==='strategies') main.innerHTML = STRATEGIES_HTML;
    else if(lesson.id==='playbook') main.innerHTML = PLAYBOOK_HTML;
  } else if(lesson.type==='practice'){
    renderPractice();
  } else if(lesson.type==='quiz'){
    renderQuiz();
  }
  updateStats();
}

/* =========================================================
   EVENT DELEGATION
========================================================= */
document.addEventListener('click', function(e){
  // Navigation
  const target = e.target.closest('[data-nav]');
  if(target){
    const i = parseInt(target.dataset.nav);
    if(!isNaN(i)){
      if(target.dataset.complete){
        completeAndNext(target.dataset.complete, i);
      } else {
        goToLesson(i);
      }
    }
    return;
  }

  // Task tabs
  const taskTab = e.target.closest('[data-task-tab]');
  if(taskTab){
    currentTask = parseInt(taskTab.dataset.taskTab);
    render();
    return;
  }

  // Task practice picks
  const taskPick = e.target.closest('[data-task-pick]');
  if(taskPick){
    const [ti, ci] = taskPick.dataset.taskPick.split('-').map(Number);
    const t = TASKS_DATA[ti];
    const feedback = document.getElementById(`taskFeedback-${ti}`);
    if(!feedback) return;
    // Highlight
    document.querySelectorAll(`[data-task-pick^="${ti}-"]`).forEach(el=>{
      el.classList.remove('correct','wrong');
    });
    if(ci === t.practice.correct){
      taskPick.classList.add('correct');
      feedback.innerHTML = `<div class="bg-[var(--ok)]/10 border-l-4 border-[var(--ok)] rounded-r-lg p-3 text-sm"><b class="text-[var(--ok)]">✅ Correct!</b> ${t.practice.feedback}</div>`;
    } else {
      taskPick.classList.add('wrong');
      document.querySelector(`[data-task-pick="${ti}-${t.practice.correct}"]`)?.classList.add('correct');
      feedback.innerHTML = `<div class="bg-[var(--err)]/10 border-l-4 border-[var(--err)] rounded-r-lg p-3 text-sm"><b class="text-[var(--err)]">❌ Not quite.</b> ${t.practice.feedback}</div>`;
    }
    return;
  }

  // Task text input submit
  const taskSubmit = e.target.closest('[data-task-submit]');
  if(taskSubmit){
    const ti = parseInt(taskSubmit.dataset.taskSubmit);
    const t = TASKS_DATA[ti];
    const input = document.querySelector(`[data-task-input="${ti}"]`);
    const feedback = document.getElementById(`taskFeedback-${ti}`);
    if(!input || !feedback) return;
    const userAnswer = input.value.trim().toLowerCase();
    const correctWords = t.practice.answers.map(w=>w.toLowerCase());
    const allCorrect = correctWords.every(w => userAnswer.includes(w));
    if(allCorrect){
      feedback.innerHTML = `<div class="bg-[var(--ok)]/10 border-l-4 border-[var(--ok)] rounded-r-lg p-3 text-sm"><b class="text-[var(--ok)]">✅ Correct!</b> ${t.practice.feedback}</div>`;
    } else {
      feedback.innerHTML = `<div class="bg-[var(--err)]/10 border-l-4 border-[var(--err)] rounded-r-lg p-3 text-sm"><b class="text-[var(--err)]">❌ Not quite.</b> Correct answers: ${t.practice.answers.join(', ')}. ${t.practice.feedback}</div>`;
    }
    return;
  }

  // Question type tabs
  const qtypeTab = e.target.closest('[data-qtype-tab]');
  if(qtypeTab){
    currentQType = parseInt(qtypeTab.dataset.qtypeTab);
    render();
    return;
  }

  // Question type practice picks
  const qtypePick = e.target.closest('[data-qtype-pick]');
  if(qtypePick){
    const [qi, ci] = qtypePick.dataset.qtypePick.split('-').map(Number);
    const q = QTYPES[qi];
    const feedback = document.getElementById(`qtypeFeedback-${qi}`);
    if(!feedback) return;
    document.querySelectorAll(`[data-qtype-pick^="${qi}-"]`).forEach(el=>{
      el.classList.remove('correct','wrong');
    });
    if(ci === q.practice.correct){
      qtypePick.classList.add('correct');
      feedback.innerHTML = `<div class="bg-[var(--ok)]/10 border-l-4 border-[var(--ok)] rounded-r-lg p-3 text-sm"><b class="text-[var(--ok)]">✅ Correct!</b> ${q.practice.feedback}</div>`;
    } else {
      qtypePick.classList.add('wrong');
      document.querySelector(`[data-qtype-pick="${qi}-${q.practice.correct}"]`)?.classList.add('correct');
      feedback.innerHTML = `<div class="bg-[var(--err)]/10 border-l-4 border-[var(--err)] rounded-r-lg p-3 text-sm"><b class="text-[var(--err)]">❌ Not quite.</b> ${q.practice.feedback}</div>`;
    }
    return;
  }

  // Practice picks
  const practicePick = e.target.closest('[data-practice-pick]');
  if(practicePick){
    const [qi, ci] = practicePick.dataset.practicePick.split('-').map(Number);
    if(!isNaN(qi) && !isNaN(ci)) pickPractice(qi, ci);
    return;
  }

  // Practice submit
  const practiceSubmit = e.target.closest('[data-practice-submit]');
  if(practiceSubmit){
    const qi = parseInt(practiceSubmit.dataset.practiceSubmit);
    if(!isNaN(qi)) submitPractice(qi);
    return;
  }

  // Quiz picks
  const quizPick = e.target.closest('[data-quiz-pick]');
  if(quizPick){
    const [qi, ci] = quizPick.dataset.quizPick.split('-').map(Number);
    if(!isNaN(qi) && !isNaN(ci)) pickQuiz(qi, ci);
    return;
  }

  // Quiz scroll
  const quizScroll = e.target.closest('[data-quiz-scroll]');
  if(quizScroll){
    const i = parseInt(quizScroll.dataset.quizScroll);
    if(!isNaN(i)) scrollToQ(i);
    return;
  }

  // Quiz complete inputs - save on change
  const quizComplete = e.target.closest('[data-quiz-complete]');
  if(quizComplete){
    const idx = parseInt(quizComplete.dataset.quizComplete);
    state.quiz.answers[idx] = quizComplete.value.trim();
    saveState();
    return;
  }

  // Submit Module 1
  if(e.target.id === 'submitModule1Btn'){
    if(confirm('Submit Module 1 and proceed to Module 2? You cannot return to Module 1.')){
      submitModule1();
    }
    return;
  }

  // Submit Module 2
  if(e.target.id === 'submitModule2Btn'){
    const answered = Object.keys(state.quiz.answers).filter(k => {
      const idx = parseInt(k);
      return idx >= QUIZ_MODULE_1.length && state.quiz.answers[k] !== undefined && state.quiz.answers[k] !== '';
    }).length;
    if(answered < QUIZ_MODULE_2.length){
      if(!confirm(`You've answered ${answered}/${QUIZ_MODULE_2.length} questions in Module 2. Submit anyway?`)) return;
    }
    submitModule2();
    return;
  }

  // Reset
  if(e.target.id === 'resetBtn'){
    if(!confirm('Reset all progress? This cannot be undone.')) return;
    state = {...defaultState};
    saveState();
    render();
    return;
  }
});

// Save quiz complete inputs on blur
document.addEventListener('blur', function(e){
  if(e.target.matches('[data-quiz-complete]')){
    const idx = parseInt(e.target.dataset.quizComplete);
    state.quiz.answers[idx] = e.target.value.trim();
    saveState();
  }
}, true);

/* =========================================================
   INIT
========================================================= */
render();
</script>
</body>
</html>
